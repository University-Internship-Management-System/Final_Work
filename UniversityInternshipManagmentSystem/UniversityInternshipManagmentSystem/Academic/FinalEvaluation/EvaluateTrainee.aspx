<%@ Page Title="Academic Final Evaluation" Language="C#" MasterPageFile="~/Shared/Dashboard.Master" AutoEventWireup="true" Async="true" CodeBehind="FinalEvaluation.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Academic.FinalEvaluation.AcademicFinalEvaluation" %>
<asp:Content ID="PageHead" ContentPlaceHolderID="HeadContent" runat="server">
<style>
.af-page{color:#123e35}.af-title{color:#075c49;font-weight:750}.af-card{background:#fff;border:1px solid #e0e8e4;border-radius:16px;padding:22px;box-shadow:0 6px 22px rgba(18,43,57,.05);margin-bottom:20px}.af-page a{color:#08785d;font-weight:650}.af-badge{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;background:#eaf5f0;color:#075c49;font-size:.83rem;font-weight:700}.af-week{border:1px solid #dce7e1;border-radius:14px;background:#fff;margin:12px 0;overflow:hidden}.af-week summary{cursor:pointer;list-style:none;display:flex;align-items:center;gap:12px;padding:17px 20px;background:#f6faf8;transition:background .15s}.af-week summary::-webkit-details-marker{display:none}.af-week summary:hover,.af-week[open] summary{background:#eaf5f0}.af-week summary:focus-visible{outline:3px solid #8bd3b8;outline-offset:-3px}.af-week-number{display:flex;align-items:center;justify-content:center;width:42px;height:42px;flex:0 0 42px;border-radius:12px;background:#08785d;color:#fff;font-weight:800}.af-week-name{font-size:1rem;font-weight:750;color:#123e35}.af-week-meta{margin-left:auto;display:flex;align-items:center;gap:10px}.af-chevron{font-size:1.1rem;color:#08785d;transition:transform .15s}.af-week[open] .af-chevron{transform:rotate(180deg)}.af-week-content{padding:17px;display:grid;gap:14px}.af-week-empty{padding:20px;border:1px dashed #cbd9d1;border-radius:12px;background:#fbfdfc;color:#71817a;text-align:center}.af-task{border:1px solid #e3ebe6;border-radius:13px;padding:17px;background:#fff}.af-task-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap}.af-task-title{font-weight:750;font-size:1.02rem;color:#123e35;margin:0 0 4px}.af-feedback-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:15px}.af-thread{border-radius:11px;padding:15px;border:1px solid #dce8e2;background:#f9fbfa;min-height:100px}.af-thread-company{border-left:4px solid #1c9873}.af-thread-academic{border-left:4px solid #5a8bdc}.af-thread-title{font-size:.88rem;font-weight:800;margin-bottom:9px;color:#29493e}.af-thread-body{white-space:pre-wrap;line-height:1.6;color:#43584f;overflow-wrap:anywhere}.af-reply-editor{margin-top:14px;padding:16px;border-radius:12px;background:#f4f8fd;border:1px solid #dce6f4}.af-reply-editor textarea{min-height:96px}.af-submit{margin-top:10px}.af-final{border-top:4px solid #08785d}.af-actions{display:flex;gap:10px;flex-wrap:wrap}@media(max-width:767px){.af-feedback-grid{grid-template-columns:1fr}.af-card{padding:16px}.af-week summary{padding:13px}.af-week-content{padding:11px}.af-task{padding:13px}}
</style>
</asp:Content>
<asp:Content ID="PageMain" ContentPlaceHolderID="MainContent" runat="server">
<div class="container-fluid py-3 af-page">
    <div class="mb-4"><a href="<%: ResolveUrl("~/Academic/FinalEvaluation/Trainees.aspx") %>?companyId=<%: Server.UrlEncode(Request.QueryString["companyId"] ?? String.Empty) %>">&larr; Students</a><div class="small text-uppercase fw-bold text-success mt-3">Academic Supervisor</div><h1 class="af-title mb-1 uims-page-title">Trainee final review</h1><p class="text-muted mb-0">Open a week to review its tasks, company comments, and your feedback.</p></div>
    <asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert" role="status"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
    <asp:Panel ID="pnlError" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Literal ID="litError" runat="server" /></asp:Panel>
    <asp:Panel ID="pnlReview" runat="server" Visible="false">
        <section class="af-card"><div class="d-flex justify-content-between align-items-start flex-wrap gap-3"><div><span class="small text-uppercase fw-bold text-success">Trainee</span><h2 class="h4 mb-1"><asp:Literal ID="litStudentName" runat="server" /></h2><div class="text-muted"><asp:Literal ID="litStudentInfo" runat="server" /></div></div><span class="af-badge">Company passed</span></div><hr/><h3 class="h5">Company final evaluation</h3><div class="row g-3"><div class="col-md-3"><strong>Approved hours</strong><div><asp:Literal ID="litHours" runat="server" /></div></div><div class="col-md-3"><strong>Training dates</strong><div><asp:Literal ID="litDates" runat="server" /></div></div><div class="col-md-6"><strong>Company ratings</strong><div><asp:Literal ID="litCompanyRatings" runat="server" /></div></div></div><div class="mt-3"><strong>Company final comment</strong><div class="text-muted mt-1"><asp:Literal ID="litCompanyComments" runat="server" /></div></div></section>
        <section class="af-card"><div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3"><div><h3 class="h5 mb-1">Weekly tasks</h3><p class="text-muted mb-0">All six weeks are listed. Open any week to review its tasks and comments.</p></div><span class="af-badge">6 training weeks</span></div>
            <asp:Repeater ID="rptTaskWeeks" runat="server" OnItemDataBound="rptTaskWeeks_ItemDataBound"><ItemTemplate>
                <details class="af-week"><summary><span class="af-week-number"><%#: Eval("WeekNumber") %></span><span class="af-week-name">Week <%#: Eval("WeekNumber") %></span><span class="af-week-meta"><span class="af-badge"><%#: Eval("TaskCount") %> tasks</span><span class="af-chevron" aria-hidden="true">⌄</span></span></summary>
                    <div class="af-week-content"><asp:Panel ID="pnlWeekEmpty" runat="server" Visible='<%# !(bool)Eval("HasTasks") %>' CssClass="af-week-empty">No tasks are assigned for this week.</asp:Panel>
                        <asp:Repeater ID="rptWeekTasks" runat="server" OnItemCommand="rptTasks_ItemCommand"><ItemTemplate>
                            <article class="af-task"><div class="af-task-head"><div><h4 class="af-task-title"><%#: Eval("TaskName") %></h4><span class="small text-muted">Deadline: <%#: Eval("Deadline") %></span></div><div class="text-end"><span class="af-badge"><%#: Eval("SubmissionStatus") %></span><div><asp:HyperLink ID="lnkSubmission" runat="server" Visible='<%# (bool)Eval("HasSubmission") %>' NavigateUrl='<%# Eval("SubmissionLink") %>' Target="_blank" Text="Open latest submission" /></div></div></div>
                                <div class="af-feedback-grid"><div class="af-thread af-thread-company"><div class="af-thread-title">Company comments</div><div class="af-thread-body"><%#: Eval("CompanyFeedbackHistory") %></div></div><div class="af-thread af-thread-academic"><div class="af-thread-title">Your saved comments</div><div class="af-thread-body"><%#: Eval("AcademicFeedbackHistory") %></div></div></div>
                                <asp:Panel ID="pnlReplyEditor" runat="server" Visible='<%# (bool)Eval("HasSubmission") %>' CssClass="af-reply-editor"><asp:Label ID="lblAcademicFeedback" runat="server" AssociatedControlID="txtAcademicFeedback" CssClass="af-thread-title" Text="Your comment on the latest submission"/><asp:TextBox ID="txtAcademicFeedback" runat="server" Text='<%# Eval("AcademicFeedback") %>' TextMode="MultiLine" Rows="3" MaxLength="2000" CssClass="form-control" Enabled='<%# (bool)Eval("CanComment") %>' placeholder="Write your feedback for this task..."/><asp:LinkButton ID="btnSaveTaskFeedback" runat="server" CommandName="SaveAcademicFeedback" CommandArgument='<%# Eval("SubmissionId") %>' CssClass="btn btn-success btn-sm af-submit" Visible='<%# (bool)Eval("CanComment") %>'>Save comment</asp:LinkButton><asp:Label runat="server" Visible='<%# (bool)Eval("HasSubmission") && !(bool)Eval("CanComment") %>' CssClass="small text-muted mt-2" Text="This evaluation was sent; comments are read-only." /></asp:Panel>
                                <asp:Panel ID="pnlNeedsSubmission" runat="server" Visible='<%# !(bool)Eval("HasSubmission") %>' CssClass="af-week-empty mt-3">The student has not submitted this task yet. Comments can be added after a submission appears.</asp:Panel>
                            </article>
                        </ItemTemplate></asp:Repeater>
                    </div>
                </details>
            </ItemTemplate></asp:Repeater>
        </section>
        <section class="af-card af-final"><div class="small text-uppercase fw-bold text-success">Final decision</div><h3 class="h5">Academic comment and Pass</h3><asp:Label ID="lblAcademicStatus" runat="server" CssClass="af-badge"/><div class="mt-3"><asp:Label ID="lblFinalComment" runat="server" AssociatedControlID="txtFinalComment" CssClass="form-label fw-bold" Text="Final comment"/><asp:TextBox ID="txtFinalComment" runat="server" TextMode="MultiLine" Rows="4" MaxLength="4000" CssClass="form-control" placeholder="Add your final comment about the trainee..."/></div><div class="af-actions mt-3"><asp:Button ID="btnSaveDraft" runat="server" Text="Save draft" CssClass="btn btn-outline-primary" OnClick="btnSaveDraft_Click"/><asp:Button ID="btnPassToCoordinator" runat="server" Text="Pass and send to coordinator" CssClass="btn btn-success" OnClick="btnPassToCoordinator_Click" OnClientClick="return confirm('Pass this trainee and send the academic evaluation to the coordinator?');"/></div></section>
    </asp:Panel>
</div>
</asp:Content>
