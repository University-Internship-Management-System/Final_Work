<%@ Page Title="Completion Review" Language="C#" MasterPageFile="~/Shared/Dashboard.Master" AutoEventWireup="true" Async="true" CodeBehind="FinalCompletionReview.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.FinalCompletionReview" %>
<asp:Content ID="PageHead" ContentPlaceHolderID="HeadContent" runat="server"><style>
.cr-page{color:#123e35}.cr-title{color:#075c49;font-weight:750}.cr-card{background:#fff;border:1px solid #e0e8e4;border-radius:14px;padding:20px;box-shadow:0 5px 18px rgba(18,43,57,.04);margin-bottom:18px}.cr-table{width:100%;border-collapse:collapse}.cr-table th,.cr-table td{padding:12px;border-bottom:1px solid #e7ece9;text-align:left;vertical-align:top}.cr-table th{color:#687b74;white-space:nowrap}.cr-table a{color:#08785d;font-weight:650}.cr-note{white-space:pre-wrap;overflow-wrap:anywhere}.cr-badge{display:inline-block;padding:4px 9px;border-radius:20px;background:#eaf5f0;color:#075c49;font-weight:650}
</style></asp:Content>
<asp:Content ID="PageMain" ContentPlaceHolderID="MainContent" runat="server"><div class="container-fluid py-3 cr-page">
    <div class="mb-4"><div class="small text-uppercase fw-bold text-success">Coordinator</div><h1 class="cr-title mb-1 uims-page-title">Completion Review</h1><p class="text-muted mb-0">Review company and academic approvals before approving the student's certificate.</p></div>
    <asp:Panel ID="pnlMessage" runat="server" Visible="false" CssClass="alert" role="status"><asp:Literal ID="litMessage" runat="server" /></asp:Panel>
    <asp:Panel ID="pnlError" runat="server" Visible="false" CssClass="alert alert-danger" role="alert"><asp:Literal ID="litError" runat="server" /></asp:Panel>
    <section class="cr-card"><h2 class="h4">Students passed by company and academic supervisors</h2><div class="table-responsive"><table class="cr-table"><thead><tr><th>Student</th><th>Company</th><th>Company</th><th>Academic</th><th>Coordinator</th><th></th></tr></thead><tbody><asp:Literal ID="litCandidateRows" runat="server" /></tbody></table></div></section>
    <asp:Panel ID="pnlReview" runat="server" Visible="false">
        <section class="cr-card"><h2 class="h4"><asp:Literal ID="litStudentName" runat="server" /></h2><p class="text-muted"><asp:Literal ID="litStudentInfo" runat="server" /></p><div class="row g-3"><div class="col-lg-6"><div class="border rounded p-3 h-100"><h3 class="h5">Company evaluation</h3><div><strong>Hours:</strong> <asp:Literal ID="litCompanyHours" runat="server" /></div><div><strong>Ratings:</strong> <asp:Literal ID="litCompanyRatings" runat="server" /></div><div class="mt-2"><strong>Company comment:</strong><div class="cr-note text-muted"><asp:Literal ID="litCompanyComment" runat="server" /></div></div></div></div><div class="col-lg-6"><div class="border rounded p-3 h-100"><h3 class="h5">Academic evaluation</h3><div><strong>Academic supervisor:</strong> <asp:Literal ID="litAcademicSupervisor" runat="server" /></div><div class="mt-2"><strong>Final academic comment:</strong><div class="cr-note text-muted"><asp:Literal ID="litAcademicComment" runat="server" /></div></div></div></div></div></section>
        <section class="cr-card"><h3 class="h5">Task feedback</h3><div class="table-responsive"><table class="cr-table"><thead><tr><th>Task</th><th>Company feedback</th><th>Academic feedback</th></tr></thead><tbody><asp:Literal ID="litTaskRows" runat="server" /></tbody></table></div>
            <div class="mt-3"><asp:Label ID="lblAdminComment" runat="server" AssociatedControlID="txtAdminComment" CssClass="form-label fw-bold" Text="Coordinator comment (optional)" /><asp:TextBox ID="txtAdminComment" runat="server" TextMode="MultiLine" Rows="3" MaxLength="2000" CssClass="form-control" /></div>
            <asp:Button ID="btnApprove" runat="server" Text="Pass and save certificate" CssClass="btn btn-success mt-3" OnClick="btnApprove_Click" OnClientClick="return confirm('Approve completion and save the certificate record?');" />
        </section>
    </asp:Panel>
</div></asp:Content>
