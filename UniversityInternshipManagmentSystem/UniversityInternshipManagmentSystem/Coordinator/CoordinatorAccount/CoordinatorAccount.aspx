<%@ Page Title="Coordinator Account" Language="C#" Async="true" AutoEventWireup="true" CodeBehind="CoordinatorAccount.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.CoordinatorAccountPage" MasterPageFile="~/Shared/Dashboard.Master" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server"><link href="coordinator-account.css?v=20261023-1" rel="stylesheet" /></asp:Content>
<asp:Content ID="body" ContentPlaceHolderID="MainContent" runat="server">
    <header class="ca-heading"><p class="ca-eyebrow">COORDINATOR / ACCOUNT</p><h1 class="page-title uims-page-title">My account</h1><p class="text-muted">Your profile, contact details and sign-in security.</p></header>
    <asp:Panel ID="noticePanel" runat="server" Visible="false" role="status"><asp:Literal ID="notice" runat="server" Mode="Encode" /></asp:Panel>
    <asp:Panel ID="workspace" runat="server" Visible="false">
        <section class="ca-profile-banner"><div class="ca-profile-person"><asp:Panel ID="imagePanel" runat="server" CssClass="ca-avatar"><asp:Image ID="avatar" runat="server" AlternateText="Coordinator profile photo" /></asp:Panel><asp:Panel ID="initialsPanel" runat="server" CssClass="ca-avatar ca-initials"><asp:Literal ID="initials" Mode="Encode" runat="server" /></asp:Panel><div><span class="ca-banner-label">University Internship Coordinator</span><h2><asp:Literal ID="displayName" Mode="Encode" runat="server" /></h2><p><asp:Literal ID="displayEmail" Mode="Encode" runat="server" /></p></div></div><span class="ca-role"><i class="bi bi-shield-check" aria-hidden="true"></i> Administrator</span></section>
        <div class="ca-layout"><asp:Panel ID="profileEditor" runat="server" CssClass="card ca-details" DefaultButton="editProfile"><div class="ca-section-title"><span class="ca-icon"><i class="bi bi-person" aria-hidden="true"></i></span><div><h2>Personal information</h2><p>Keep your coordinator details up to date.</p></div></div>
            <div class="ca-fields"><div><asp:Label runat="server" AssociatedControlID="fullName" Text="Full name *" /><asp:TextBox ID="fullName" runat="server" CssClass="form-control" MaxLength="100" autocomplete="name" /></div><div><asp:Label runat="server" AssociatedControlID="phone" Text="Phone number" /><asp:TextBox ID="phone" runat="server" CssClass="form-control" MaxLength="10" autocomplete="tel-national" inputmode="numeric" placeholder="0791234567" /></div><asp:Panel ID="photoEditor" runat="server" CssClass="ca-wide" Visible="false"><asp:Label runat="server" AssociatedControlID="profilePhoto" Text="Profile photo (optional)" /><asp:FileUpload ID="profilePhoto" runat="server" CssClass="form-control ca-file" accept="image/jpeg,image/png" /><small>Choose a JPG or PNG image up to 2 MB. Save changes to upload it. Leave empty to keep your current photo.</small></asp:Panel></div>
            <div class="ca-divider"></div><h3 class="ca-subheading">Sign-in information</h3><div class="ca-fields"><div class="ca-wide"><asp:Label runat="server" AssociatedControlID="email" Text="Email address" /><asp:TextBox ID="email" runat="server" ReadOnly="true" CssClass="form-control" /><small>Your sign-in email is managed through account authentication.</small></div></div>
            <div class="ca-actions"><asp:Button ID="editProfile" runat="server" Text="Edit profile" CssClass="btn btn-primary" OnClick="EditProfile" CausesValidation="false" /><asp:Button ID="saveProfile" runat="server" Visible="false" Text="Save changes" CssClass="btn btn-primary" OnClick="SaveProfile" /><asp:Button ID="cancelProfile" runat="server" Visible="false" Text="Cancel" CssClass="btn btn-outline-primary" OnClick="CancelChanges" CausesValidation="false" /></div>
        </asp:Panel><aside><section class="card ca-security"><span class="ca-icon ca-icon-large"><i class="bi bi-shield-lock" aria-hidden="true"></i></span><h2>Account security</h2><p>Choose a unique password to protect your coordinator account.</p><button type="button" class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#passwordModal">Change password</button><div class="ca-security-note"><i class="bi bi-lock" aria-hidden="true"></i><span>Your password is managed securely by Firebase Authentication.</span></div></section><section class="ca-help"><h3>Your coordinator access</h3><p>Your account can manage student and supervisor accounts, assignments and internship coordination.</p></section></aside></div>
        <asp:HiddenField ID="openPassword" ClientIDMode="Static" runat="server" Value="0" />
        <div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content ca-modal"><div class="modal-header"><div><p class="ca-eyebrow">ACCOUNT SECURITY</p><h2 class="modal-title" id="passwordModalTitle">Change password</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">
            <p class="ca-modal-description">Confirm your current password, then choose a new one.</p><asp:Panel ID="passwordNoticePanel" runat="server" Visible="false" CssClass="ca-notice ca-error" role="alert"><asp:Literal ID="passwordNotice" Mode="Encode" runat="server" /></asp:Panel>
            <div class="ca-modal-field"><asp:Label runat="server" AssociatedControlID="currentPassword" Text="Current password" /><div class="ca-password"><asp:TextBox ID="currentPassword" ClientIDMode="Static" runat="server" TextMode="Password" CssClass="form-control" autocomplete="current-password" MaxLength="128" /><button type="button" data-password="currentPassword" aria-label="Show current password">Show</button></div></div>
            <div class="ca-modal-field"><asp:Label runat="server" AssociatedControlID="newPassword" Text="New password" /><div class="ca-password"><asp:TextBox ID="newPassword" ClientIDMode="Static" runat="server" TextMode="Password" CssClass="form-control" autocomplete="new-password" MaxLength="128" /><button type="button" data-password="newPassword" aria-label="Show new password">Show</button></div><small>Use at least 6 characters.</small></div>
            <div class="ca-modal-field"><asp:Label runat="server" AssociatedControlID="confirmPassword" Text="Confirm new password" /><div class="ca-password"><asp:TextBox ID="confirmPassword" ClientIDMode="Static" runat="server" TextMode="Password" CssClass="form-control" autocomplete="new-password" MaxLength="128" /><button type="button" data-password="confirmPassword" aria-label="Show password confirmation">Show</button></div></div>
        </div><div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button><asp:Button ID="savePassword" runat="server" Text="Update password" CssClass="btn btn-primary" OnClick="ChangePassword" /></div></div></div></div>
    </asp:Panel>
    <script src="<%= ResolveUrl("~/Coordinator/CoordinatorAccount/coordinator-account.js?v=20261023-1") %>" defer></script>
</asp:Content>
