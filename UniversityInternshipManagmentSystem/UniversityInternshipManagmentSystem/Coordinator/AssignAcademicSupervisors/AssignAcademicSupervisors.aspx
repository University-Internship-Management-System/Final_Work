<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AssignAcademicSupervisors.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.AssignAcademicSupervisorsPage" MasterPageFile="~/Shared/Dashboard.Master" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server">
    <link href="assign-supervisors.css" rel="stylesheet" />
</asp:Content>
<asp:Content ID="content" ContentPlaceHolderID="MainContent" runat="server">
    <header class="assign-heading"><div><p class="assign-eyebrow">COORDINATOR / ACCOUNT MANAGEMENT</p><h1 class="page-title">Assign academic supervisors</h1><p class="text-muted">Organize students by major and manage their academic supervision.</p></div><a class="btn btn-outline-primary" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Manage supervisors</a></header>
    <p class="assign-preview" role="note">Interface preview. Student and supervisor records will be loaded when this page is connected to Firebase. No assignments are saved yet.</p>
    <ol class="assign-steps" aria-label="Assignment process"><li><span>1</span>Choose a major</li><li><span>2</span>Select students</li><li><span>3</span>Choose a matching supervisor</li></ol>
    <section class="card assign-filters" aria-labelledby="filterTitle"><h2 id="filterTitle" class="section-title">Find a student group</h2><div class="assign-filter-grid"><div><label for="assignMajor">Major</label><select id="assignMajor" class="form-select"><option value="">Select a major</option><option value="Computer Science">Computer Science</option><option value="Cybersecurity">Cybersecurity</option><option value="Computer Information Systems">Computer Information Systems</option><option value="Business Information Technology">Business Information Technology</option><option value="Data Science">Data Science</option><option value="Artificial Intelligence">Artificial Intelligence</option></select></div><div><label for="assignSearch">Student name or university email</label><input id="assignSearch" type="search" class="form-control" placeholder="Select a major first" maxlength="120" disabled /></div><div><label for="assignStatus">Current assignment</label><select id="assignStatus" class="form-select" disabled><option value="All">All students</option><option value="Unassigned">Unassigned</option><option value="Assigned">Already assigned</option></select></div></div></section>
    <div class="assign-grid">
        <section class="card assign-students" aria-labelledby="studentsTitle"><div class="assign-section-heading"><div><h2 id="studentsTitle" class="section-title">Students</h2><p id="assignGroupCaption" class="text-muted">Select a major to prepare a student group.</p></div><span id="assignSelectionBadge" class="badge badge-submitted">0 selected</span></div><div class="assign-table-toolbar"><label class="assign-checkbox-label"><input id="assignSelectAll" type="checkbox" class="form-check-input" disabled /> Select all visible students</label><button id="assignClear" type="button" class="btn btn-outline-primary btn-sm" disabled>Clear selection</button></div>
            <div class="table-responsive"><table class="table align-middle assign-table"><thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Student</th><th scope="col">Major</th><th scope="col">Current supervisor</th></tr></thead><tbody id="assignStudentRows"><tr id="assignEmptyRow"><td colspan="4"><div class="assign-empty"><span class="assign-empty-icon" aria-hidden="true">S</span><h3 id="assignEmptyTitle" class="card-title">Choose a major to begin</h3><p id="assignEmptyMessage">Select students from the same major, then assign them to a matching academic supervisor.</p></div></td></tr></tbody></table></div>
            <p class="assign-footnote">Current supervisor details will make it clear which students are being assigned for the first time and which are being reassigned.</p>
        </section>
        <aside class="card assign-panel" aria-labelledby="assignmentTitle"><p class="assign-eyebrow">GROUP ASSIGNMENT</p><h2 id="assignmentTitle" class="section-title">Set academic supervisor</h2><p class="text-muted">All selected students must have the same major as the supervisor.</p><dl class="assign-summary"><dt>Selected major</dt><dd id="assignSummaryMajor">Not selected</dd><dt>Selected students</dt><dd id="assignSummaryCount">0</dd></dl>
            <label for="assignSupervisor">Academic supervisor</label><select id="assignSupervisor" class="form-select" aria-describedby="assignSupervisorHelp" disabled><option value="">Select a major first</option></select><p id="assignSupervisorHelp" class="assign-help" role="status">Matching supervisor accounts will appear here after the data connection is ready.</p><a class="assign-manage-link" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Create or manage academic supervisors</a>
            <div class="assign-reassignment-note"><h3 class="card-title">Changing a supervisor?</h3><p>The new supervisor will replace the current assignment for the selected students. Other students will keep their assignments.</p></div>
            <button id="assignReviewButton" type="button" class="btn btn-primary w-100" disabled>Review assignment</button><p id="assignActionHelp" class="assign-help">Choose students and a matching supervisor to review the assignment.</p>
        </aside>
    </div>
    <dialog id="assignReview" aria-labelledby="assignReviewTitle"><div class="assign-review-heading"><h2 id="assignReviewTitle" class="section-title">Review assignment</h2><button id="assignCloseReview" type="button" aria-label="Close review">&times;</button></div><dl class="assign-summary"><dt>Major</dt><dd id="assignReviewMajor"></dd><dt>New supervisor</dt><dd id="assignReviewSupervisor"></dd><dt>Students selected</dt><dd id="assignReviewCount"></dd></dl><ul id="assignReviewStudents" class="assign-review-students"></ul><p class="assign-preview">This is a review only. Saving assignments will be connected in the backend phase.</p><button id="assignBack" type="button" class="btn btn-primary">Back to selection</button></dialog>
    <script src="<%= ResolveUrl("~/Coordinator/AssignAcademicSupervisors/assign-supervisors.js") %>" defer></script>
</asp:Content>
