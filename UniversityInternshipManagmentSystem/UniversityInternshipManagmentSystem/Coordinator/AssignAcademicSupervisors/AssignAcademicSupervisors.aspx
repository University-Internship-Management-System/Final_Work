<%@ Page Title="Assign academic supervisors" Language="C#" Async="true" AutoEventWireup="true" ViewStateEncryptionMode="Always" CodeBehind="AssignAcademicSupervisors.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.AssignAcademicSupervisorsPage" MasterPageFile="~/Shared/Dashboard.Master" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server"><link href="assign-supervisors.css?v=20261024-1" rel="stylesheet" /></asp:Content>
<asp:Content ID="content" ContentPlaceHolderID="MainContent" runat="server">
    <asp:ScriptManager ID="assignScripts" runat="server" />
    <header class="assign-heading"><div><p class="assign-eyebrow">COORDINATOR / ACADEMIC SUPERVISION</p><h1 class="page-title">Assign academic supervisors</h1><p class="text-muted">Choose a student group, select a supervisor, then review your assignment.</p></div><a class="btn btn-outline-primary" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Manage supervisors</a></header>
    <asp:UpdatePanel ID="noticeUpdate" runat="server"><ContentTemplate><asp:Panel ID="messagePanel" runat="server" Visible="false" CssClass="assign-notice assign-error" role="alert"><asp:Literal ID="message" runat="server" Mode="Encode" /></asp:Panel></ContentTemplate></asp:UpdatePanel>
    <asp:Panel ID="workspace" runat="server" Visible="false" DefaultButton="searchButton">
        <ol class="assign-steps" aria-label="Assignment steps"><li><span>1</span><div><strong>Choose a major</strong><small>Find the student group</small></div></li><li><span>2</span><div><strong>Select students &amp; supervisor</strong><small>Choose who receives the assignment</small></div></li><li><span>3</span><div><strong>Review &amp; confirm</strong><small>Check the details before saving</small></div></li></ol>
        <section class="card assign-filters" aria-labelledby="filterTitle"><h2 id="filterTitle">Find a student group</h2><div class="assign-filter-grid">
            <div><label for="assignMajor">Major</label><asp:DropDownList ID="assignMajor" ClientIDMode="Static" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="MajorChanged"><asp:ListItem Value="">Select a major</asp:ListItem><asp:ListItem>Computer Science</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Computer Information Systems</asp:ListItem><asp:ListItem>Business Information Technology</asp:ListItem><asp:ListItem>Data Science</asp:ListItem><asp:ListItem>Artificial Intelligence</asp:ListItem></asp:DropDownList></div>
            <div><label for="assignSearch">Student name or university email</label><div class="assign-search-field"><asp:TextBox ID="assignSearch" ClientIDMode="Static" runat="server" CssClass="form-control" MaxLength="120" placeholder="Search students" OnTextChanged="SelectionChanged" /><asp:Button ID="searchButton" runat="server" Text="Search" CssClass="btn btn-outline-primary" OnClick="SelectionChanged" CausesValidation="false" /></div></div>
        </div></section>
        <asp:UpdatePanel ID="selectionUpdate" runat="server"><ContentTemplate>
            <div class="assign-grid">
                <section class="card assign-students" aria-labelledby="studentsTitle">
                    <div class="assign-section-heading"><div><h2 id="studentsTitle">Select students</h2><p><asp:Literal ID="groupCaption" Mode="Encode" runat="server" /></p></div><span class="assign-count"><asp:Literal ID="selectedCount" runat="server" /></span></div>
                    <div class="assign-table-toolbar"><asp:CheckBox ID="selectAll" ClientIDMode="Static" runat="server" Text="Select all listed students" AutoPostBack="true" OnCheckedChanged="SelectAllChanged" CssClass="assign-select-all" /><asp:Button ID="clearSelection" runat="server" Text="Clear selection" CssClass="btn btn-outline-primary btn-sm" OnClick="ClearSelection" CausesValidation="false" /></div>
                    <div class="assign-list-scroll"><table class="table assign-table"><thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Student</th><th scope="col">Current supervisor</th></tr></thead><tbody>
                        <asp:Repeater ID="students" runat="server"><ItemTemplate><tr data-student-row><td><asp:CheckBox ID="selectedStudent" runat="server" AutoPostBack="true" OnCheckedChanged="SelectionChanged" aria-label="Select student" /><asp:HiddenField ID="studentId" runat="server" Value='<%# Eval("Id") %>' /></td><td><strong><%#: Eval("Name") %></strong><small><%#: Eval("UniEmail") %></small></td><td><span class="assign-mobile-label">Current supervisor: </span><%#: SupervisorName((string)Eval("AcademicSupervisorId")) %></td></tr></ItemTemplate></asp:Repeater>
                    </tbody></table><asp:Panel ID="emptyStudents" runat="server" Visible="false" CssClass="assign-empty"><i class="bi bi-people" aria-hidden="true"></i><h3>No students to display</h3><p>Choose a major or change your search.</p></asp:Panel></div>
                    <p class="assign-help assign-selection-help">Search keeps your selection. Changing the major clears it.</p>
                </section>
                <aside class="card assign-panel" aria-labelledby="assignmentTitle"><p class="assign-eyebrow">ACADEMIC SUPERVISION</p><h2 id="assignmentTitle">Choose a supervisor</h2><p class="text-muted">Select students from the list, then choose their academic supervisor.</p><label for="assignSupervisor">Academic supervisor</label><asp:DropDownList ID="assignSupervisor" ClientIDMode="Static" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="SelectionChanged" /><p class="assign-help"><asp:Literal ID="supervisorHelp" runat="server" Mode="Encode" /></p><a class="assign-manage-link" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Create or manage supervisors</a><div class="assign-reassignment-note"><i class="bi bi-info-circle" aria-hidden="true"></i><p>The chosen supervisor replaces the current assignment for selected students only.</p></div><asp:Button ID="reviewButton" ClientIDMode="Static" runat="server" Text="Review assignment" CssClass="btn btn-primary w-100" OnClick="ReviewAssignment" CausesValidation="false" /></aside>
            </div>
        </ContentTemplate><Triggers>
            <asp:AsyncPostBackTrigger ControlID="searchButton" EventName="Click" /><asp:AsyncPostBackTrigger ControlID="assignMajor" EventName="SelectedIndexChanged" /><asp:AsyncPostBackTrigger ControlID="assignSearch" EventName="TextChanged" /><asp:AsyncPostBackTrigger ControlID="assignSupervisor" EventName="SelectedIndexChanged" /><asp:AsyncPostBackTrigger ControlID="selectAll" EventName="CheckedChanged" /><asp:AsyncPostBackTrigger ControlID="clearSelection" EventName="Click" /><asp:AsyncPostBackTrigger ControlID="reviewButton" EventName="Click" /><asp:AsyncPostBackTrigger ControlID="confirmButton" EventName="Click" />
        </Triggers></asp:UpdatePanel>
    </asp:Panel>

    <div class="modal fade assign-modal" id="assignReviewModal" tabindex="-1" aria-labelledby="reviewTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <asp:UpdatePanel ID="reviewUpdate" runat="server"><ContentTemplate>
            <asp:HiddenField ID="openReview" ClientIDMode="Static" runat="server" Value="0" />
            <asp:Panel ID="reviewPanel" runat="server" Visible="false" CssClass="assign-review">
                <div class="modal-header"><div><p class="assign-eyebrow">FINAL STEP</p><h2 id="reviewTitle" class="modal-title">Review assignment</h2><p class="assign-review-intro">Check the selected students and their new academic supervisor.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body"><asp:Panel ID="reviewNotice" runat="server" Visible="false" CssClass="assign-notice assign-error" role="alert"><asp:Literal ID="reviewError" runat="server" Mode="Encode" /></asp:Panel><p class="assign-review-summary"><i class="bi bi-person-check" aria-hidden="true"></i><asp:Literal ID="reviewSummary" Mode="Encode" runat="server" /></p><ul class="assign-review-students"><asp:Repeater ID="reviewStudents" runat="server"><ItemTemplate><li><span class="assign-student-icon"><i class="bi bi-person" aria-hidden="true"></i></span><div><strong><%#: Eval("Name") %></strong><small>Current supervisor: <%#: SupervisorName((string)Eval("AcademicSupervisorId")) %></small></div></li></ItemTemplate></asp:Repeater></ul></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Back to selection</button><asp:Button ID="confirmButton" ClientIDMode="Static" runat="server" Text="Confirm assignment" CssClass="btn btn-primary" OnClick="ConfirmAssignment" CausesValidation="false" /></div>
            </asp:Panel>
        </ContentTemplate><Triggers><asp:AsyncPostBackTrigger ControlID="confirmButton" EventName="Click" /></Triggers></asp:UpdatePanel>
    </div></div></div>
    <asp:Panel ID="savedPanel" runat="server" Visible="false"><div class="modal fade assign-result-modal" id="assignSavedModal" tabindex="-1" aria-labelledby="savedTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body"><span class="assign-result-icon"><i class="bi bi-check-lg" aria-hidden="true"></i></span><h2 id="savedTitle">Assignment saved</h2><p>The selected students have been assigned to their academic supervisor successfully.</p><button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button></div></div></div></div></asp:Panel>
    <script src="<%= ResolveUrl("~/Coordinator/AssignAcademicSupervisors/assign-supervisors.js?v=20261024-1") %>" defer></script>
</asp:Content>
