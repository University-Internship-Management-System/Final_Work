<%@ Page Title="Students" Language="C#" Async="true" AutoEventWireup="true" CodeBehind="ManageStudents.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.ManageStudentsPage" MasterPageFile="~/Shared/Dashboard.Master" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server">
    <link href="students.css?v=20261021-2" rel="stylesheet" />
</asp:Content>
<asp:Content ID="content" ContentPlaceHolderID="MainContent" runat="server">
    <header class="student-heading"><div><p class="student-eyebrow">COORDINATOR / ACCOUNT MANAGEMENT</p><h1 class="page-title">Students</h1><p class="text-muted">Manage student accounts and academic supervisor assignments.</p></div><asp:LinkButton ID="addStudent" runat="server" Visible="false" CssClass="btn btn-primary" Text="Add student" OnClick="AddClick" CausesValidation="false" /></header>
    <asp:Panel ID="messagePanel" runat="server" CssClass="student-preview" role="status" Visible="false"><asp:Literal ID="message" runat="server" Mode="Encode" /></asp:Panel>
    <asp:Panel ID="workspace" runat="server" Visible="false">
        <section class="card student-card" aria-labelledby="directoryTitle"><div class="student-section-heading"><div><h2 id="directoryTitle">Student directory</h2><p class="text-muted">Academic details and the supervisor responsible for each student.</p></div><span class="student-count"><asp:Literal ID="studentCount" runat="server" /> students</span></div>
            <div class="student-search-tools"><asp:Label runat="server" AssociatedControlID="studentSearch" CssClass="visually-hidden" Text="Search students" /><asp:TextBox ID="studentSearch" ClientIDMode="Static" runat="server" CssClass="form-control" MaxLength="120" placeholder="Search student, email or supervisor" /><asp:Label runat="server" AssociatedControlID="majorFilter" CssClass="visually-hidden" Text="Filter by major" /><asp:DropDownList ID="majorFilter" ClientIDMode="Static" runat="server" CssClass="form-select"><asp:ListItem Value="">All majors</asp:ListItem><asp:ListItem>Computer Science</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Computer Information Systems</asp:ListItem><asp:ListItem>Business Information Technology</asp:ListItem><asp:ListItem>Data Science</asp:ListItem><asp:ListItem>Artificial Intelligence</asp:ListItem></asp:DropDownList><asp:Button ID="searchButton" ClientIDMode="Static" runat="server" CssClass="btn btn-outline-primary" Text="Search" OnClick="SearchClick" CausesValidation="false" formnovalidate="formnovalidate" /></div>
            <table class="table student-table"><thead><tr><th scope="col">Student</th><th scope="col">Major</th><th scope="col">Academic supervisor</th><th scope="col">GPA</th><th scope="col">Action</th></tr></thead><tbody><asp:Repeater ID="students" runat="server" OnItemCommand="StudentsCommand"><ItemTemplate><tr data-student-row data-major='<%#: Eval("Major") %>'><td><strong><%#: Eval("Name") %></strong><small><%#: Eval("UniEmail") %></small><small><%#: Eval("Email") %></small></td><td><span class="student-mobile-label">Major</span><%#: Eval("Major") %></td><td><span class="student-mobile-label">Supervisor</span><%#: Eval("SupervisorName") %></td><td><span class="student-mobile-label">GPA</span><%#: Eval("GPA") %></td><td><asp:LinkButton runat="server" CssClass="btn btn-outline-primary btn-sm" Text="Edit" CommandName="EditStudent" CommandArgument='<%# Eval("Id") %>' CausesValidation="false" /></td></tr></ItemTemplate></asp:Repeater></tbody></table>
            <p id="studentLiveEmpty" class="student-empty" hidden>No matching students. Try another name or major.</p>
            <asp:Panel ID="emptyDirectory" runat="server" CssClass="student-empty" Visible="false"><h3>No matching students</h3><p>Add a student or change the search filters.</p></asp:Panel>
        </section>
        <asp:Panel ID="editorPanel" runat="server" Visible="false"><section id="studentEditor" class="card student-card" aria-labelledby="editorTitle"><p class="student-eyebrow">STUDENT ACCOUNT</p><h2 id="editorTitle"><asp:Literal ID="editorHeading" runat="server" Text="Add student" /></h2><p class="student-university-note">The University of Jordan · King Abdullah II School of Information Technology</p>
            <fieldset class="student-fields"><legend>Student details</legend><div class="student-form-grid">
                <div><asp:Label runat="server" AssociatedControlID="studentName" Text="Full name *" /><asp:TextBox ID="studentName" ClientIDMode="Static" runat="server" CssClass="form-control" MaxLength="100" autocomplete="name" /></div>
                <div><asp:Label runat="server" AssociatedControlID="loginEmail" Text="Login email *" /><asp:TextBox ID="loginEmail" runat="server" CssClass="form-control" MaxLength="254" inputmode="email" /><small>Login email is fixed after account creation.</small></div>
                <div><asp:Label runat="server" AssociatedControlID="universityEmail" Text="University email *" /><asp:TextBox ID="universityEmail" runat="server" CssClass="form-control" MaxLength="254" inputmode="email" /></div>
                <div><asp:Label runat="server" AssociatedControlID="phoneNumber" Text="Phone number *" /><asp:TextBox ID="phoneNumber" runat="server" CssClass="form-control" TextMode="Phone" MaxLength="25" placeholder="+962 7X XXX XXXX" /></div>
            </div></fieldset>
            <fieldset class="student-fields"><legend>Academic information</legend><div class="student-form-grid">
                <div><asp:Label runat="server" AssociatedControlID="studentMajor" Text="Major *" /><asp:DropDownList ID="studentMajor" ClientIDMode="Static" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="MajorChanged" CausesValidation="false"><asp:ListItem Value="">Select a major</asp:ListItem><asp:ListItem>Computer Science</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Computer Information Systems</asp:ListItem><asp:ListItem>Business Information Technology</asp:ListItem><asp:ListItem>Data Science</asp:ListItem><asp:ListItem>Artificial Intelligence</asp:ListItem></asp:DropDownList></div>
                <div><asp:Label runat="server" AssociatedControlID="gpa" Text="GPA *" /><asp:TextBox ID="gpa" runat="server" CssClass="form-control" TextMode="Number" min="0" max="4" step="0.01" placeholder="e.g. 3.50" /></div>
                <div><label for="requiredHours">Required training hours</label><input id="requiredHours" class="form-control" value="90" readonly /><small>At least 15 hours per week for 6 weeks.</small></div>
                <div><asp:Label runat="server" AssociatedControlID="academicSupervisor" Text="Academic supervisor *" /><asp:DropDownList ID="academicSupervisor" ClientIDMode="Static" runat="server" CssClass="form-select"><asp:ListItem Value="">Select a major first</asp:ListItem></asp:DropDownList><small><asp:Literal ID="supervisorHelp" runat="server" Mode="Encode" /></small><a class="student-manage-link" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Manage academic supervisors</a></div>
            </div></fieldset>
            <asp:Panel ID="passwordSection" runat="server"><fieldset class="student-fields"><legend>Account access</legend><div class="student-password-field"><asp:Label runat="server" AssociatedControlID="temporaryPassword" Text="Temporary password *" /><div class="student-password"><asp:TextBox ID="temporaryPassword" ClientIDMode="Static" runat="server" CssClass="form-control" TextMode="Password" MaxLength="128" autocomplete="new-password" aria-describedby="passwordHelp" /><button id="togglePassword" type="button" aria-controls="temporaryPassword" aria-pressed="false">Show</button></div><small id="passwordHelp">At least 12 characters. The student must change it at first login.</small></div></fieldset></asp:Panel>
            <div class="student-actions"><asp:Button ID="saveButton" runat="server" CssClass="btn btn-primary" Text="Create account" OnClick="SaveClick" formnovalidate="formnovalidate" /><asp:Button runat="server" CssClass="btn btn-outline-primary" Text="Cancel" OnClick="CancelClick" CausesValidation="false" formnovalidate="formnovalidate" /></div>
        </section></asp:Panel>
    </asp:Panel>
    <script src="<%= ResolveUrl("~/Coordinator/ManageStudents/students.js?v=20261021-2") %>" defer></script>
</asp:Content>
