<%@ Page Title="Students" Language="C#" Async="true" AsyncTimeout="300" AutoEventWireup="true" ViewStateEncryptionMode="Always" CodeBehind="ManageStudents.aspx.cs" Inherits="UniversityInternshipManagmentSystem.Coordinator.ManageStudentsPage" MasterPageFile="~/Shared/Dashboard.Master" %>
<asp:Content ID="head" ContentPlaceHolderID="HeadContent" runat="server"><link href="students.css?v=20261023-import" rel="stylesheet" /></asp:Content>
<asp:Content ID="content" ContentPlaceHolderID="MainContent" runat="server">
    <asp:ScriptManager ID="studentScripts" runat="server" />
    <header class="student-heading"><div><p class="student-eyebrow">COORDINATOR / ACCOUNT MANAGEMENT</p><h1 class="page-title">Students</h1><p class="text-muted">Manage student accounts and academic supervisor assignments.</p></div><div class="student-heading-actions"><asp:HyperLink runat="server" NavigateUrl="ManageStudents.aspx?import=1" CssClass="btn btn-outline-primary"><i class="bi bi-upload" aria-hidden="true"></i> Import students</asp:HyperLink><asp:HyperLink ID="addStudent" runat="server" Visible="false" CssClass="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add student</asp:HyperLink></div></header>
    <asp:Panel ID="messagePanel" runat="server" role="status" Visible="false"><asp:Literal ID="message" runat="server" Mode="Encode" /></asp:Panel>
    <asp:Panel ID="workspace" runat="server" Visible="false" DefaultButton="searchButton">
        <section class="student-summary" aria-label="Students total"><div class="student-summary-main"><span class="student-summary-icon"><i class="bi bi-people" aria-hidden="true"></i></span><div><span class="student-summary-label">Students</span><strong><asp:Literal ID="studentCount" runat="server" /></strong></div></div><p>Registered student accounts.<br />Assign each student to a supervisor from the same major.</p></section>
        <section class="card student-card" aria-labelledby="directoryTitle"><div class="student-section-heading"><div><h2 id="directoryTitle">Student directory</h2><p class="text-muted">Student profiles, academic details and assigned supervisors.</p></div></div>
            <div class="student-search-tools"><div class="student-search-field"><asp:Label runat="server" AssociatedControlID="studentSearch" CssClass="visually-hidden" Text="Search students" /><i class="bi bi-search" aria-hidden="true"></i><asp:TextBox ID="studentSearch" ClientIDMode="Static" runat="server" CssClass="form-control" MaxLength="120" OnTextChanged="SearchChanged" placeholder="Search name, email or supervisor" /></div><asp:Label runat="server" AssociatedControlID="majorFilter" CssClass="visually-hidden" Text="Filter by major" /><asp:DropDownList ID="majorFilter" ClientIDMode="Static" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="SearchChanged"><asp:ListItem Value="">All majors</asp:ListItem><asp:ListItem>Computer Science</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Computer Information Systems</asp:ListItem><asp:ListItem>Business Information Technology</asp:ListItem><asp:ListItem>Data Science</asp:ListItem><asp:ListItem>Artificial Intelligence</asp:ListItem></asp:DropDownList><asp:Button ID="searchButton" ClientIDMode="Static" runat="server" CssClass="btn btn-outline-primary" Text="Search" OnClick="SearchChanged" CausesValidation="false" /></div>
            <asp:UpdatePanel ID="directoryUpdate" runat="server" UpdateMode="Conditional"><ContentTemplate>
            <table class="table student-table"><thead><tr><th scope="col">Student</th><th scope="col">Major</th><th scope="col">Academic supervisor</th><th scope="col">GPA</th><th scope="col">Action</th></tr></thead><tbody><asp:Repeater ID="students" runat="server"><ItemTemplate><tr data-student-row><td><strong><%#: Eval("Name") %></strong><small><%#: Eval("UniEmail") %></small><small><%#: Eval("Email") %></small></td><td><span class="student-mobile-label">Major</span><%#: Eval("Major") %></td><td><span class="student-mobile-label">Supervisor</span><%#: SupervisorName((string)Eval("AcademicSupervisorId")) %></td><td><span class="student-mobile-label">GPA</span><%#: Eval("GPA", "{0:0.00}") %></td><td><asp:HyperLink runat="server" CssClass="btn btn-outline-primary btn-sm" Text="Edit" NavigateUrl='<%# EditUrl((string)Eval("Id")) %>' /></td></tr></ItemTemplate></asp:Repeater></tbody></table>
            <asp:Panel ID="emptyDirectory" runat="server" CssClass="student-empty" Visible="false"><i class="bi bi-search" aria-hidden="true"></i><h3>No matching students</h3><p>Add a student or try another search.</p></asp:Panel>
            <nav class="student-pagination" aria-label="Student directory pages"><span><asp:Literal ID="pageSummary" runat="server" /></span><div><asp:HyperLink ID="previousPage" runat="server" CssClass="btn btn-outline-primary btn-sm" Text="Previous" /><asp:HyperLink ID="nextPage" runat="server" CssClass="btn btn-outline-primary btn-sm" Text="Next" /></div></nav>
            </ContentTemplate><Triggers><asp:AsyncPostBackTrigger ControlID="studentSearch" EventName="TextChanged" /><asp:AsyncPostBackTrigger ControlID="majorFilter" EventName="SelectedIndexChanged" /><asp:AsyncPostBackTrigger ControlID="searchButton" EventName="Click" /></Triggers></asp:UpdatePanel>
        </section>
    </asp:Panel>
    <div class="modal fade student-modal" id="studentModal" tabindex="-1" aria-labelledby="editorTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <asp:UpdatePanel ID="editorUpdate" runat="server" UpdateMode="Conditional"><ContentTemplate>
        <asp:HiddenField ID="openEditor" ClientIDMode="Static" runat="server" Value="0" />
        <asp:Panel ID="editorPanel" runat="server" CssClass="student-editor" Visible="false" DefaultButton="saveButton">
            <div class="modal-header"><div><p class="student-eyebrow">STUDENT ACCOUNT</p><h2 id="editorTitle" class="modal-title"><asp:Literal ID="editorHeading" runat="server" Text="Add student" /></h2><p class="student-university-note">The University of Jordan · King Abdullah II School of Information Technology</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
            <asp:Panel ID="editorNotice" runat="server" CssClass="student-notice student-error" Visible="false" role="alert"><asp:Literal ID="editorMessage" Mode="Encode" runat="server" /></asp:Panel>
            <fieldset class="student-fields"><legend><span>1</span> Student details</legend><div class="student-form-grid">
                <div><asp:Label runat="server" AssociatedControlID="studentName" Text="Full name *" /><asp:TextBox ID="studentName" ClientIDMode="Static" runat="server" CssClass="form-control" MaxLength="100" autocomplete="name" /></div>
                <div><asp:Label runat="server" AssociatedControlID="loginEmail" Text="Login email *" /><asp:TextBox ID="loginEmail" runat="server" CssClass="form-control" MaxLength="254" inputmode="email" /><small>Login email is fixed after account creation.</small></div>
                <div><asp:Label runat="server" AssociatedControlID="universityEmail" Text="University email *" /><asp:TextBox ID="universityEmail" runat="server" CssClass="form-control" MaxLength="254" inputmode="email" /></div>
                <div><asp:Label runat="server" AssociatedControlID="phoneNumber" Text="Phone number *" /><div class="student-phone"><asp:DropDownList ID="phoneCountry" runat="server" AutoPostBack="true" OnSelectedIndexChanged="PhoneCountryChanged" CssClass="form-select" aria-label="Phone country code">
<asp:ListItem data-pattern="7[0-9]{8}" data-length="9" data-digits="9" Value="+962">Jordan +962</asp:ListItem>
<asp:ListItem data-pattern="5[69][0-9]{7}" data-length="9" data-digits="9" Value="+970">Palestine +970</asp:ListItem>
<asp:ListItem data-pattern="9[0-9]{8}" data-length="9" data-digits="9" Value="+963">Syria +963</asp:ListItem>
<asp:ListItem data-pattern="(?:3[0-9]{6}|[78][0-9]{7})" data-length="8" data-digits="7 or 8" Value="+961">Lebanon +961</asp:ListItem>
<asp:ListItem data-pattern="7[0-9]{9}" data-length="10" data-digits="10" Value="+964">Iraq +964</asp:ListItem>
<asp:ListItem data-pattern="1[0125][0-9]{8}" data-length="10" data-digits="10" Value="+20">Egypt +20</asp:ListItem>
<asp:ListItem data-pattern="5[0-9]{8}" data-length="9" data-digits="9" Value="+966">Saudi Arabia +966</asp:ListItem>
<asp:ListItem data-pattern="5[0-9]{8}" data-length="9" data-digits="9" Value="+971">UAE +971</asp:ListItem>
<asp:ListItem data-pattern="[4569][0-9]{7}" data-length="8" data-digits="8" Value="+965">Kuwait +965</asp:ListItem>
<asp:ListItem data-pattern="[3567][0-9]{7}" data-length="8" data-digits="8" Value="+974">Qatar +974</asp:ListItem>
<asp:ListItem data-pattern="[36][0-9]{7}" data-length="8" data-digits="8" Value="+973">Bahrain +973</asp:ListItem>
<asp:ListItem data-pattern="[179][0-9]{7}" data-length="8" data-digits="8" Value="+968">Oman +968</asp:ListItem>
<asp:ListItem data-pattern="7[0-9]{8}" data-length="9" data-digits="9" Value="+967">Yemen +967</asp:ListItem></asp:DropDownList><asp:TextBox ID="phoneNumber" runat="server" CssClass="form-control" TextMode="Phone" MaxLength="15" placeholder="Mobile number" /></div><small><asp:Literal ID="phoneHelp" runat="server" Mode="Encode" /></small></div>
            </div></fieldset>
            <fieldset class="student-fields"><legend><span>2</span> Academic information</legend><div class="student-form-grid">
                <div><asp:Label runat="server" AssociatedControlID="studentMajor" Text="Major *" /><asp:DropDownList ID="studentMajor" ClientIDMode="Static" runat="server" CssClass="form-select" AutoPostBack="true" OnSelectedIndexChanged="MajorChanged" CausesValidation="false"><asp:ListItem Value="">Select a major</asp:ListItem><asp:ListItem>Computer Science</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Computer Information Systems</asp:ListItem><asp:ListItem>Business Information Technology</asp:ListItem><asp:ListItem>Data Science</asp:ListItem><asp:ListItem>Artificial Intelligence</asp:ListItem></asp:DropDownList></div>
                <div><asp:Label runat="server" AssociatedControlID="gpa" Text="GPA *" /><asp:TextBox ID="gpa" runat="server" CssClass="form-control" TextMode="Number" min="0" max="4" step="0.01" placeholder="e.g. 3.50" /></div>
                <div><asp:Label runat="server" AssociatedControlID="academicSupervisor" Text="Academic supervisor *" /><asp:DropDownList ID="academicSupervisor" ClientIDMode="Static" runat="server" CssClass="form-select"><asp:ListItem Value="">Select a major first</asp:ListItem></asp:DropDownList><small><asp:Literal ID="supervisorHelp" runat="server" Mode="Encode" /></small><a class="student-manage-link" runat="server" href="~/Coordinator/ManageAcademicSupervisors/ManageAcademicSupervisors.aspx">Manage academic supervisors</a></div>
                <div><label for="requiredHours">Required training hours</label><input id="requiredHours" class="form-control" value="90" readonly /><small>At least 15 hours per week for 6 weeks.</small></div>
            </div></fieldset>
            <asp:Panel ID="passwordSection" runat="server"><fieldset class="student-fields student-password-section"><legend><span>3</span> Account access</legend><asp:Label runat="server" AssociatedControlID="temporaryPassword" Text="Temporary password" /><div class="student-password"><asp:TextBox ID="temporaryPassword" ClientIDMode="Static" runat="server" CssClass="form-control" ReadOnly="true" autocomplete="off" spellcheck="false" /><asp:Button ID="generatePassword" runat="server" CssClass="btn btn-outline-primary" Text="Regenerate" OnClick="GeneratePassword" CausesValidation="false" /></div><small>Generated automatically. Copy it before saving; the student must change it at first login.</small></fieldset></asp:Panel>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Cancel</button><asp:Button ID="saveButton" ClientIDMode="Static" runat="server" CssClass="btn btn-primary" Text="Create account" OnClick="SaveClick" formnovalidate="formnovalidate" /></div>
        </asp:Panel>
        </ContentTemplate><Triggers><asp:AsyncPostBackTrigger ControlID="phoneCountry" EventName="SelectedIndexChanged" /><asp:AsyncPostBackTrigger ControlID="studentMajor" EventName="SelectedIndexChanged" /><asp:AsyncPostBackTrigger ControlID="generatePassword" EventName="Click" /><asp:AsyncPostBackTrigger ControlID="saveButton" EventName="Click" /></Triggers></asp:UpdatePanel>
    </div></div></div>

    <div class="modal fade student-import-modal" id="studentImportModal" tabindex="-1" aria-labelledby="importTitle" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><div><p class="student-eyebrow">BULK STUDENT ACCOUNTS</p><h2 id="importTitle" class="modal-title">Import students</h2><p class="text-muted mb-0">Prepare your file, review the students, then confirm.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body">
            <asp:HiddenField ID="openImport" ClientIDMode="Static" runat="server" Value="0" /><asp:HiddenField ID="importToken" runat="server" />
            <div class="student-import-steps"><span><b>1</b> Prepare CSV</span><span><b>2</b> Review data</span><span><b>3</b> Create accounts</span></div>
            <div class="student-import-guide"><div><h3>Start with the template</h3><p>Fill it in Excel on your computer, one student per row. Save as <strong>CSV UTF-8</strong>. Up to 25 students and 256 KB per file.</p></div><asp:HyperLink runat="server" NavigateUrl="ManageStudents.aspx?template=1" CssClass="btn btn-outline-primary" Text="Download template" /></div>
            <details class="student-import-reference"><summary>Column guide, majors and supervisor emails</summary><p>Keep all 8 headers in order. CountryCode: for example +962. PhoneNumber: 790000000 (9 digits for Jordan, without +962 or a leading zero). Format these two Excel columns as Text before entering numbers. GPA: 0–4, using a decimal point.</p><p>Majors: Computer Science, Cybersecurity, Computer Information Systems, Business Information Technology, Data Science, Artificial Intelligence. Use the exact major name and a supervisor email from the same major below.</p><div class="student-import-table"><table class="table"><thead><tr><th>Supervisor</th><th>Email</th><th>Major</th></tr></thead><tbody><asp:Repeater ID="importSupervisors" runat="server"><ItemTemplate><tr><td><%#: Eval("Name") %></td><td><%#: Eval("Email") %></td><td><%#: Eval("Major") %></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></details>
            <asp:Panel ID="importNotice" runat="server" Visible="false" CssClass="student-notice student-error" role="alert"><asp:Literal ID="importMessage" runat="server" Mode="Encode" /></asp:Panel>
            <div class="student-import-upload"><div><asp:Label runat="server" AssociatedControlID="importFile" Text="Choose your completed CSV file" /><asp:FileUpload ID="importFile" runat="server" CssClass="form-control" accept=".csv,text/csv" /></div><asp:Button ID="previewImportButton" runat="server" CssClass="btn btn-outline-primary" Text="Preview file" OnClick="PreviewImport" CausesValidation="false" /></div>
            <asp:Panel ID="importPreview" runat="server" Visible="false"><h3 class="student-import-preview-title">Review students</h3><p role="status"><asp:Literal ID="importSummary" runat="server" Mode="Encode" /></p><p class="text-muted">If a row has an error, correct the file on your computer and preview it again. Confirmation is available when all rows pass. Authentication also checks login email availability during creation.</p><div class="student-import-table"><table class="table"><thead><tr><th>Row</th><th>Student / login email</th><th>Major</th><th>Result</th></tr></thead><tbody><asp:Repeater ID="importRows" runat="server"><ItemTemplate><tr><td><%#: Eval("RowNumber") %></td><td><strong><%#: Eval("Student.Name") %></strong><small><%#: Eval("Student.Email") %></small></td><td><%#: Eval("Student.Major") %></td><td><span class='<%# Eval("Error") == null ? "student-import-ready" : "student-import-error" %>'><%#: Eval("Status") %></span></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></asp:Panel>
            <p class="student-import-footnote">New accounts use random temporary passwords and require email verification and a password change at first sign-in. Welcome emails use the site's existing email service; delivery depends on its configuration. Keep this window open while accounts are being created.</p>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">Close</button><asp:Button ID="confirmImport" runat="server" Visible="false" CssClass="btn btn-primary" Text="Confirm import" OnClick="ConfirmImport" CausesValidation="false" /></div>
    </div></div></div>

    <asp:Panel ID="savedPanel" runat="server" Visible="false"><div class="modal fade student-saved-modal" id="studentSavedModal" tabindex="-1" aria-labelledby="savedTitle"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-body"><span class="student-success-icon"><i class="bi bi-check-lg" aria-hidden="true"></i></span><h2 id="savedTitle">Student saved</h2><p><asp:Literal ID="savedMessage" runat="server" Mode="Encode" /></p><button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button></div></div></div></div></asp:Panel>
    <script src="<%= ResolveUrl("~/Coordinator/ManageStudents/students.js?v=20261023-import") %>" defer></script>
</asp:Content>
