<%@ Master Language="C#" %>
<%@ Register Src="~/Shared/Navbar.ascx" TagPrefix="uims" TagName="Navbar" %>
<%@ Register Src="~/Shared/Footer.ascx" TagPrefix="uims" TagName="Footer" %>

<script runat="server">
    protected override void OnInit(EventArgs e)
    {
        base.OnInit(e);
        bool customHome = string.Equals(Page.AppRelativeVirtualPath, "~/index.aspx", StringComparison.OrdinalIgnoreCase);
        StandardPublicNavigation.Visible = !customHome;
        StandardPublicFooter.Visible = !customHome;
    }
</script>
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> | Field Training System - The University of Jordan (KASIT)</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.2.3 CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom UIMS Theme -->
    <link href="~/Shared/uims.css" rel="stylesheet" />
    <link href="~/Assets/css/uims-theme.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="uims-public d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">
        <!-- Main Navigation Bar -->
        <asp:PlaceHolder ID="StandardPublicNavigation" runat="server"><uims:Navbar runat="server" /></asp:PlaceHolder>

        <!-- Main Content -->
        <main class="flex-grow-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <!-- Institutional Footer -->
        <asp:PlaceHolder ID="StandardPublicFooter" runat="server"><uims:Footer runat="server" /></asp:PlaceHolder>
    </form>

    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
</body>
</html>
