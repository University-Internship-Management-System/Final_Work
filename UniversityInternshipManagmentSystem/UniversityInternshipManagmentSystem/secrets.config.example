<?xml version="1.0" encoding="utf-8"?>
<!--
  The team's email settings are already in Web.config, so you do NOT need this file.
  Copy it to "secrets.config" only if you want to send from a different Gmail on your PC: it overrides Web.config.
  Copy this file to "secrets.config" (same folder) and fill in the values.
  secrets.config is ignored by git, so the password never goes to GitHub.
  The values below are for Gmail. In Gmail you need an "App password":
  Google account -> Security -> 2-Step Verification (turn on) -> App passwords.
-->
<appSettings>
	<add key="SmtpHost" value="smtp.gmail.com" />
	<add key="SmtpPort" value="587" />
	<add key="SmtpUser" value="your.address@gmail.com" />
	<add key="SmtpPassword" value="your-16-letter-app-password" />
	<add key="SmtpFromName" value="UIMS" />
</appSettings>
